model USER {
    id          String      @id @default(uuid())
    email       String      @unique
    name        String
    password    String?
    avatar      String?
    provider    Provider
    accountType AccountType @default(USER)
    isVerified  Boolean     @default(false)
    createdAt   DateTime    @default(now())
    updatedAt   DateTime?    @updatedAt
    deletedAt   DateTime?
    @@index([email, accountType], name: "email_accountType_index")
    @@map("users")
}
