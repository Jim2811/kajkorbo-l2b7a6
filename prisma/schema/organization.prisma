model Organization {
    id          String    @id @default(uuid())
    name        String
    email       String    @unique
    phone       String?
    address     String?
    slug        String?
    plan        PlanType  @default(FREE)
    isSuspended Boolean   @default(false)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    deletedAt   DateTime?

    @@map("organization")
}
